<content-type>
  <display-name>Lokalforening</display-name>
  <super-type>base:structured</super-type>
  <description>A local association within a district.</description>

  <form>
    <input name="sourceId" type="TextLine">
      <label>Source ID</label>
      <occurrences minimum="1" maximum="1"/>
      <help-text>The unique ID from the original source system.</help-text>
    </input>
    <item-set name="api_activities">  
  <label>Aktiviteter fra API</label>  
  <occurrences minimum="0" maximum="0"/>  
  <items>
    <input name="global_activity_name" type="TextLine">
      <label>Global activity name</label>
      <occurrences minimum="0" maximum="1"/>
    </input>
    <input name="local_activity_name" type="TextLine">
      <label>Local activity name</label>
      <occurrences minimum="0" maximum="1"/>
    </input>
     <input name="local_activity_name" type="TextArea">
      <label>Berikende tekst for den lokale aktiviteten</label>
      <occurrences minimum="0" maximum="1"/>
    </input>
  </items>
</item-set>
  </form>

</content-type>