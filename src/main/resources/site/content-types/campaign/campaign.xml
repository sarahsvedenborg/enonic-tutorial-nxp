<?xml version="1.0" encoding="UTF-8"?>
<content-type xmlns="urn:enonic:xp:model:1.0">
  <display-name>Kampanje</display-name>
  <description>Kampanjer til forskjellige formål</description>
  <super-type>base:structured</super-type>
  <form>
   <input type="ImageSelector" name="photos">
      <label>Toppbilde</label>
      <occurrences minimum="0" maximum="1"/>
    </input>
     <input type="ContentSelector" name="donationForm">
      <label>Giverskjema</label>
      <occurrences minimum="0" maximum="1"/>
      <config>
        <allowContentType>${app}:giverskjema</allowContentType>
      </config>
    </input>
    <input type="HtmlArea" name="body">
      <label>Brødtekst</label>
      <occurrences minimum="1" maximum="1"/>
      <config>
        <exclude>NumberedList Outdent Indent SpecialChar Anchor Table PasteModeSwitcher</exclude>
      </config>
    </input>
 <input type="ContentSelector" name="arguments">
      <label>Argumenter (gode grunner)</label>
      <occurrences minimum="0" maximum="0"/>
      <config>
        <allowContentType>${app}:argument</allowContentType>
      </config>
    </input>
 
  </form>
</content-type>
